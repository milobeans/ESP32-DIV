--- /dev/null
+++ b/components/lvgl_esp32_drivers/hiwonder_board.h
@@ -0,0 +1,11 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "esp_err.h"
+
+/* Hiwonder 2-inch ESP32-S3 board: XL9555 keys/backlight, no GPIO backlight. */
+esp_err_t hiwonder_board_init(void);
+esp_err_t hiwonder_board_set_backlight(bool on);
+/* Active-high bits: KEY1=0, KEY2=1, KEY3=2, KEY4=3, BOOT=4. */
+uint8_t hiwonder_board_read_keys(void);
