+#ifdef CONFIG_HIWONDER_S3
+static void hiwonder_poll_keys(void)
+{
+  static uint8_t candidate;
+  static uint8_t stable;
+  static uint8_t swallowed;
+  static uint32_t candidate_since;
+  static uint32_t repeat_at[2];
+  const uint32_t now = dm_now_ms();
+  const uint8_t raw = hiwonder_board_read_keys();
+  /* KEY3 and BOOT are the same logical Select button. */
+  const uint8_t keys = (raw & 0x0b) | ((raw & 0x14) ? 0x04 : 0);
+  const int joystick_index[] = {2, 4, 1}; /* Up, Down, Select */
+  if (keys != candidate) {
+    candidate = keys;
+    candidate_since = now;
+  }
+  if (now - candidate_since >= 20 && candidate != stable) {
+    const uint8_t changed = candidate ^ stable;
+    stable = candidate;
+    for (unsigned i = 0; i < 4; ++i) {
+      const uint8_t mask = 1u << i;
+      if (!(changed & mask)) continue;
+      const bool pressed = (stable & mask) != 0;
+      if (i < 3) plugin_api_record_joystick_state(joystick_index[i], pressed);
+      if (pressed && display_manager_notify_user_input()) {
+        swallowed |= mask;
+        continue;
+      }
+      if (swallowed & mask) {
+        if (!pressed) swallowed &= (uint8_t)~mask;
+        continue;
+      }
+      if (i == 3) {
+        if (pressed) {
+          InputEvent event = {.type = INPUT_TYPE_EXIT_BUTTON, .data.exit_pressed = true};
+          xQueueSend(input_queue, &event, 0);
+        }
+      } else {
+        InputEvent event = {
+          .type = INPUT_TYPE_JOYSTICK,
+          .data.joystick_index = joystick_index[i],
+          .data.joystick_pressed = pressed,
+        };
+        xQueueSend(input_queue, &event, 0);
+        if (i < 2) repeat_at[i] = pressed ? now + get_joystick_repeat_initial_delay() : 0;
+      }
+    }
+  }
+  for (unsigned i = 0; i < 2; ++i) {
+    const uint8_t mask = 1u << i;
+    if (!(stable & mask) || (swallowed & mask) || !repeat_at[i]) continue;
+    if ((int32_t)(now - repeat_at[i]) >= 0) {
+      last_touch_time = xTaskGetTickCount();
+      InputEvent event = {
+        .type = INPUT_TYPE_JOYSTICK,
+        .data.joystick_index = joystick_index[i],
+        .data.joystick_pressed = true,
+      };
+      xQueueSend(input_queue, &event, 0);
+      repeat_at[i] = now + get_joystick_repeat_interval();
+    }
+  }
+}
+#endif
