diff --git a/components/lvgl_esp32_drivers/hiwonder_board.c b/components/lvgl_esp32_drivers/hiwonder_board.c
new file mode 100644
index 0000000..c0d3034
--- /dev/null
+++ b/components/lvgl_esp32_drivers/hiwonder_board.c
@@ -0,0 +1,91 @@
+#include "sdkconfig.h"
+
+#ifdef CONFIG_HIWONDER_S3
+#include "hiwonder_board.h"
+#include "driver/gpio.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "lvgl_i2c/i2c_manager.h"
+
+#define XL9555_ADDRESS 0x20
+#define KEY_MASK 0xf0
+#define BACKLIGHT_MASK 0x40
+
+static const char *TAG = "Hiwonder";
+static SemaphoreHandle_t expander_mutex;
+static bool expander_ready;
+static bool boot_ready;
+static bool initialized;
+static bool backlight_on;
+
+/* Read the OUTPUT latch, never the INPUT register, when changing outputs.
+ * Only keys P0.4..7 and backlight P1.6 belong to this driver. Preserve audio,
+ * camera and every other unrelated expander pin and its direction/polarity. */
+static esp_err_t update_register(uint8_t reg, uint8_t mask, uint8_t bits)
+{
+    uint8_t value;
+    esp_err_t err = lvgl_i2c_read(I2C_NUM_0, XL9555_ADDRESS, reg, &value, 1);
+    if (err != ESP_OK) return err;
+    const uint8_t updated = (value & (uint8_t)~mask) | (bits & mask);
+    if (updated == value) return ESP_OK;
+    return lvgl_i2c_write(I2C_NUM_0, XL9555_ADDRESS, reg, &updated, 1);
+}
+
+esp_err_t hiwonder_board_init(void)
+{
+    if (initialized) return expander_ready ? ESP_OK : ESP_ERR_INVALID_STATE;
+    initialized = true;
+
+    const gpio_config_t boot_config = {
+        .pin_bit_mask = 1ULL << GPIO_NUM_0,
+        .mode = GPIO_MODE_INPUT,
+        .pull_up_en = GPIO_PULLUP_ENABLE,
+        .pull_down_en = GPIO_PULLDOWN_DISABLE,
+        .intr_type = GPIO_INTR_DISABLE,
+    };
+    boot_ready = gpio_config(&boot_config) == ESP_OK;
+
+    expander_mutex = xSemaphoreCreateMutex();
+    if (!expander_mutex) return ESP_ERR_NO_MEM;
+    esp_err_t err = lvgl_i2c_init(I2C_NUM_0);
+    if (err == ESP_OK) err = update_register(6, KEY_MASK, KEY_MASK);
+    if (err == ESP_OK) err = update_register(4, KEY_MASK, 0);
+    /* Set the backlight latch OFF before making P1.6 an output. */
+    if (err == ESP_OK) err = update_register(3, BACKLIGHT_MASK, 0);
+    if (err == ESP_OK) err = update_register(7, BACKLIGHT_MASK, 0);
+    expander_ready = err == ESP_OK;
+    if (!expander_ready) {
+        ESP_LOGW(TAG, "XL9555 unavailable: %s; BOOT/touch may still be used", esp_err_to_name(err));
+    } else {
+        ESP_LOGI(TAG, "XL9555 keys and backlight ready on I2C0 GPIO38/48");
+    }
+    return err;
+}
+
+esp_err_t hiwonder_board_set_backlight(bool on)
+{
+    if (!expander_ready || !expander_mutex) return ESP_ERR_INVALID_STATE;
+    if (xSemaphoreTake(expander_mutex, pdMS_TO_TICKS(50)) != pdTRUE) return ESP_ERR_TIMEOUT;
+    esp_err_t err = ESP_OK;
+    if (on != backlight_on) {
+        err = update_register(3, BACKLIGHT_MASK, on ? BACKLIGHT_MASK : 0);
+        if (err == ESP_OK) backlight_on = on;
+    }
+    xSemaphoreGive(expander_mutex);
+    return err;
+}
+
+uint8_t hiwonder_board_read_keys(void)
+{
+    uint8_t keys = boot_ready && gpio_get_level(GPIO_NUM_0) == 0 ? 0x10 : 0;
+    if (expander_ready && expander_mutex &&
+        xSemaphoreTake(expander_mutex, pdMS_TO_TICKS(25)) == pdTRUE) {
+        uint8_t inputs;
+        if (lvgl_i2c_read(I2C_NUM_0, XL9555_ADDRESS, 0, &inputs, 1) == ESP_OK)
+            keys |= ((uint8_t)~inputs & KEY_MASK) >> 4;
+        xSemaphoreGive(expander_mutex);
+    }
+    return keys;
+}
+#endif
